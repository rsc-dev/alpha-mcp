# alpha-mcp settings. Copy to one of:
#   ./.env                                   (for `uv run alpha-mcp ...` from this checkout)
#   ~/.config/alpha-mcp/.env                 (Linux)      <- what `alpha-mcp setup --origin ...` writes
#   ~/Library/Application Support/alpha-mcp/.env   (macOS)
#   %APPDATA%\alpha-mcp\.env                 (Windows)
# Real environment variables always take precedence over these files.

# Required for sync_db: [USER@]HOST:PATH of the live database (sqlite3_rsync syntax).
ALPHA_MCP_DB_ORIGIN=user@host:Z:/path/to/Global.db
# sqlite3_rsync binary on the origin host (passed as --exe). Empty when the origin is a local file.
ALPHA_MCP_REMOTE_EXE=Z:/Tools/sqlite/sqlite3_rsync.exe
# Source that `alpha-mcp setup` registers in the MCP clients.
ALPHA_MCP_GIT=git+ssh://git@github.com/rsc-dev/alpha-mcp.git@stable

# Optional overrides (defaults shown).
#ALPHA_MCP_DB_LOCAL=~/.local/share/alpha-mcp/Global.db   # %LOCALAPPDATA%\alpha-mcp\Global.db on Windows
#ALPHA_MCP_SQLITE3_RSYNC=sqlite3_rsync
#ALPHA_MCP_SSH=ssh
#ALPHA_MCP_SYNC_VERBOSITY=-vvv
#ALPHA_MCP_SYNC_TIMEOUT=600
#ALPHA_MCP_SYNC_ARGS=--protocol 1
#ALPHA_MCP_DB_MAX_AGE=21600
#ALPHA_MCP_TABLES=Tickers,InvestmentTheses

# Fund review (writes go to the local replica only; documents are stored locally).
#ALPHA_MCP_MATERIALS_ROOT=~/.local/share/alpha-mcp/Materials   # mirrors <DATASETS_PREFIX>\...\Materials
#ALPHA_MCP_DATASETS_PREFIX=Z:\DataSets
#ALPHA_MCP_DOWNLOAD_MAX_MB=50
#ALPHA_MCP_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) alpha-mcp/0.1 document fetcher
